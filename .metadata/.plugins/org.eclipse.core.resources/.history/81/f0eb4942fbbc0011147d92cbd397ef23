package application;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;

import javafx.collections.FXCollections;
import javafx.collections.ObservableList;
import javafx.geometry.Insets;
import javafx.geometry.VPos;
import javafx.scene.Cursor;
import javafx.scene.Group;
import javafx.scene.Scene;
import javafx.scene.control.Alert;
import javafx.scene.control.Button;
import javafx.scene.control.ComboBox;
import javafx.scene.control.Alert.AlertType;
import javafx.scene.layout.VBox;
import javafx.scene.paint.CycleMethod;
import javafx.scene.paint.LinearGradient;
import javafx.scene.text.Font;
import javafx.scene.text.FontWeight;
import javafx.scene.text.Text;
import javafx.scene.paint.Color;
import javafx.scene.paint.Stop;

public class EditExistingUser 
{
	public static void EditExistingUserGui(String enteredUsername, int userSecurityLevel, VBox mainArea, VBox navBar, Group root, Scene scene) throws SQLException
	{
		mainArea.getChildren().clear();
		UserOptionsHub.setUpUserOptionVBox(mainArea, navBar, root, scene);
		String userSelectedToEdit = null;
		
		Text editUserOptionsHeader = new Text("Select User To Edit:");
		editUserOptionsHeader.setFont(Font.font("Menlo",FontWeight.BOLD,24));
		LinearGradient logoTextGradient = new LinearGradient(0, 0,0, 1,true,CycleMethod.NO_CYCLE,new Stop(0, Color.web("#39414d")),new Stop(1, Color.web("#4872b5")));
		editUserOptionsHeader.setFill(logoTextGradient);
		editUserOptionsHeader.setTextOrigin(VPos.TOP);
		mainArea.getChildren().add(editUserOptionsHeader);

		
		int currentUserSecurityLevel = userSecurityLevel;
		ObservableList<String> selectableUsers = securityCheck(currentUserSecurityLevel,enteredUsername,userSelectedToEdit);
		
		ComboBox<String> userComboBox = new ComboBox<>(selectableUsers);
		userComboBox.setStyle("-fx-background-color: #c1d0de");
		userComboBox.setMaxWidth(250);
		userComboBox.setCursor(Cursor.HAND);
		userComboBox.setOnMouseEntered(event -> {userComboBox.setStyle("-fx-background-color: #d1dce6");});
		userComboBox.setOnMouseExited(event -> {userComboBox.setStyle("-fx-background-color: #c1d0de;");});
		mainArea.getChildren().add(userComboBox);
		
		
		
		Button continueButton = new Button("Continue");
		continueButton.setOnAction(event ->
		{
			System.out.println("\n" + enteredUsername + " has selected to continue to edit the user.");
			String userToEdit = userComboBox.getValue();
			System.out.println("\nSelected user to edit is: " + userToEdit);
			
			if(userToEdit != null)
			{
			try
			{
				UserEditor.userEditor(enteredUsername, userSecurityLevel, mainArea, navBar, root, scene, userToEdit);
			} 
			catch (SQLException e)
			{
				// TODO Auto-generated catch block
				e.printStackTrace();
			}
			}
			else
			{
				System.out.println("\nUser did not make a valid selction to edit.");
		    	Alert emailEmptyAlert = new Alert(AlertType.INFORMATION);
		    	emailEmptyAlert.setTitle("Empty Field Warning");
		    	emailEmptyAlert.setHeaderText("ATTENTION:");
		    	emailEmptyAlert.setContentText("You must select a user name to edit..");
		    	emailEmptyAlert.showAndWait();
		    	return;
			}

		});
		
		Button goBackButton = new Button("Cancel");
		goBackButton.setOnAction(event ->
		{
			UserOptionsHub.showUserOptionsWindow(enteredUsername, userSecurityLevel, mainArea, navBar, root, scene);
			System.out.println(enteredUsername + " backed out of edit user menu.");
		});
		
		mainArea.getChildren().add(continueButton);
		mainArea.getChildren().add(goBackButton);
		
		
		VBox.setMargin(continueButton, new Insets(25,0,25,0));
		for (javafx.scene.Node node : mainArea.getChildren()) 
		{
			
		    if (node instanceof Button button) 
		    {
		        button.setPrefHeight(50);
		        button.setPrefWidth(300);
		        button.setFont(Font.font("Menlo", FontWeight.BOLD, 16));
		        button.setStyle("-fx-background-color: #ebeced;");
		        button.setMaxWidth(300);
		        button.setMaxHeight(50);
		        button.setOnMouseEntered(event -> {button.setStyle("-fx-background-color: #fafdff");});
		        button.setOnMouseExited(event -> {button.setStyle("-fx-background-color: #ebeced;");});
		        button.setOnMousePressed(event -> {button.setStyle("-fx-background-color: #4f7e9e;");});
		        button.setOnMouseReleased(event ->{button.setStyle("-fx-background-color:  #fafdff;");});
		        button.setCursor(Cursor.HAND);
	    	}
		    
		}

		
		
		

	}
	
	public static ObservableList<String> securityCheck(int currentUserSecurityLevel,String enteredUsername, String userSelectedToEdit) throws SQLException
	{
	    ObservableList<String> selectableUsers =  FXCollections.observableArrayList();

	    if (currentUserSecurityLevel >= 3)
	    {
		    
	        String findUserSql = """
	                SELECT userName
	                FROM users
	                WHERE userSecurityLevel < ?
	                """;
	        
	        try (Connection connection = DatabaseConnection.getConnection(); 
	        		PreparedStatement checkStatement = connection.prepareStatement(findUserSql)) 
	        {

	            checkStatement.setInt(1, currentUserSecurityLevel);
	            
	            try (ResultSet results = checkStatement.executeQuery())
	            {
	                while (results.next())
	                {
	                	selectableUsers.add(results.getString("userName"));
	                }
	            }
	        }

		    return selectableUsers;
	    }
	    
	    else
	    {
	    	selectableUsers.add(enteredUsername.toString());
	    	return selectableUsers;
	    }

	}
	
	
	

}

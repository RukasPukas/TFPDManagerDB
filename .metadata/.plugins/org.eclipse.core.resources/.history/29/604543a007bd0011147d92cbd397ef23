package application;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.SQLException;

public class UpdateUserService 
{

	public static void UpdateUserDB(String userToEdit, int userSecurityLevel, String updatedFName, String updatedLName, String updatedUsername, String updatedEmail, String updatedSecurityAnswer, String updatedSecurityLevel) throws SQLException
	{
        int securityLevelConversion = 0;

        if (updatedSecurityLevel.equals("Part-Time EMS")) {securityLevelConversion = 1;}
        else if (updatedSecurityLevel.equals("POC-Fire")) {securityLevelConversion = 1;}
        else if (updatedSecurityLevel.equals("POC-Fire Lieutenant")) {securityLevelConversion = 3;}
        else if (updatedSecurityLevel.equals("Full-Time")) {securityLevelConversion = 2;}
        else if (updatedSecurityLevel.equals("Full-Time Lieutenant")) {securityLevelConversion = 3;}
        else if (updatedSecurityLevel.equals("POC-Fire Captain")) {securityLevelConversion = 3;}
        else if (updatedSecurityLevel.equals("Full-Time Captain")) {securityLevelConversion = 4;}
        else if (updatedSecurityLevel.equals("Assistant Chief")) {securityLevelConversion = 5;}
        else if (updatedSecurityLevel.equals("Deputy Chief")) {securityLevelConversion = 6;}
        else if (updatedSecurityLevel.equals("Chief")) {securityLevelConversion = 7;}
        else if (updatedSecurityLevel.equals("No change")) {securityLevelConversion = userSecurityLevel;}
        
        if (securityLevelConversion == 0)
        {
            throw new IllegalArgumentException("Invalid security level: " + updatedSecurityLevel +" was attempted to have been entered.");
        }
        

        String updateUserAccountSQL =	"UPDATE users SET firstName =?,  lastName =?,"
        		+ " userName = ?, userEmail = ?, userSecurityLevel = ?,  userSecurityAnswer =?  WHERE userName = ?;";
        
        try (Connection connection = DatabaseConnection.getConnection(); 
        		PreparedStatement updateStatement = connection.prepareStatement(updateUserAccountSQL)) 
        {

            	updateStatement.setString(1, updatedFName);
            	updateStatement.setString(2,updatedLName);
            	updateStatement.setString(3,updatedUsername);
            	updateStatement.setString(4,updatedEmail);
            	updateStatement.setInt(5, securityLevelConversion);
            	updateStatement.setString(6, updatedSecurityAnswer);
            	updateStatement.setString(7, userToEdit);
            	
        }
        
        	
	}
}

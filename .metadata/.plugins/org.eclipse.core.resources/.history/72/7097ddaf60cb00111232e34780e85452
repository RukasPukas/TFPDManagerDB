        userComboBox.setStyle("-fx-font-family: 'Menlo';" +"-fx-font-weight: bold;" +"-fx-font-size: 14px;");
        
        Text additionalEMSPrompt = new Text("Additional Members:");
        additionalEMSPrompt.setFill(Styling.logoGradient());
        additionalEMSPrompt.setFont(Font.font("Menlo",FontWeight.BOLD,18));
        GridPane.setMargin(additionalEMSPrompt, new Insets(0, 15, 50, 25));
        
        
        ObservableList<String> allPersonell =
                FXCollections.observableArrayList(allPersonell());
        

        ListView<String> runsList =new ListView<>(allPersonell);

        runsList.setMinSize(300, 150);
        runsList.setPrefSize(300, 150);
        runsList.setMaxSize(300, 150);
        runsList.getSelectionModel().setSelectionMode(SelectionMode.MULTIPLE);
        runsList.setStyle(
                "-fx-selection-bar: #39414d;" +
                "-fx-selection-bar-non-focused: #22d4b0;" +
                "-fx-selection-bar-text: white;"
        );
        GridPane.setMargin(runsList, new Insets(75, 30, 0, 25));
        runsList.setCellFactory(listView -> //for selection of multiple list cells members
        {
            ListCell<String> cell = new ListCell<>()
            {
                protected void updateItem(String item, boolean empty)
                {
                    super.updateItem(item, empty);

                    if (empty || item == null)
                    {
                        setText(null);
                    }
                    else
                    {
                        setText(item);
                    }
                }
            };

            cell.addEventFilter(MouseEvent.MOUSE_PRESSED, event ->
            {
                if (!cell.isEmpty())
                {
                    int index = cell.getIndex();

                    if (runsList.getSelectionModel().isSelected(index))
                    {
                        runsList.getSelectionModel().clearSelection(index);
                    }
                    else
                    {
                        runsList.getSelectionModel().select(index);
                    }

                    event.consume();
                }
            });

            return cell;
        });
        
        Text mutualAidPrompt = new Text("Mutual Aid:");
        mutualAidPrompt.setFill(Styling.logoGradient());
        mutualAidPrompt.setFont(Font.font("Menlo",FontWeight.BOLD,18));
        GridPane.setMargin(mutualAidPrompt, new Insets(0, 15, 50, 0));
        

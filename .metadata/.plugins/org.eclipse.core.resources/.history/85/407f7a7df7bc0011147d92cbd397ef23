package application;



import java.sql.SQLException;
import java.util.Optional;

import javafx.collections.FXCollections;
import javafx.collections.ObservableList;
import javafx.geometry.Insets;
import javafx.geometry.VPos;
import javafx.scene.Cursor;
import javafx.scene.Group;
import javafx.scene.Scene;
import javafx.scene.control.Alert;
import javafx.scene.control.Button;
import javafx.scene.control.ButtonType;
import javafx.scene.control.CheckBox;
import javafx.scene.control.ComboBox;
import javafx.scene.control.TextField;
import javafx.scene.layout.VBox;
import javafx.scene.paint.Color;
import javafx.scene.paint.CycleMethod;
import javafx.scene.paint.LinearGradient;
import javafx.scene.paint.Stop;
import javafx.scene.text.Font;
import javafx.scene.text.FontWeight;
import javafx.scene.text.Text;

public class CreateNewUser 
{
	public static void createNewUserForm(String enteredUsername, int userSecurityLevel, VBox mainArea, VBox navBar, Group root, Scene scene)
	{
		mainArea.getChildren().clear();
		UserOptionsHub.setUpUserOptionVBox(mainArea, navBar, root, scene);
		
		Text creatNewUserHeader = new Text("Create New User");
		creatNewUserHeader.setFont(Font.font("Menlo",FontWeight.BOLD,24));
		LinearGradient logoTextGradient = new LinearGradient(0, 0,0, 1,true,CycleMethod.NO_CYCLE,new Stop(0, Color.web("#39414d")),new Stop(1, Color.web("#4872b5")));
		creatNewUserHeader.setFill(logoTextGradient);
		creatNewUserHeader.setTextOrigin(VPos.TOP);
		mainArea.getChildren().add(creatNewUserHeader);	
		
		
		Text firstNamePrompt = new Text ("First Name:");
		firstNamePrompt.setFont(Font.font("Menlo",FontWeight.BOLD,18));
		firstNamePrompt.setFill(logoTextGradient);
		firstNamePrompt.setTextOrigin(VPos.TOP);
		mainArea.getChildren().add(firstNamePrompt);	
		
		
		TextField firstNameTF = new TextField();
		firstNameTF.setMaxWidth(250);
		mainArea.getChildren().add(firstNameTF);
		
		Text lastNamePrompt = new Text ("Last Name:");
		lastNamePrompt.setFont(Font.font("Menlo",FontWeight.BOLD,18));
		lastNamePrompt.setFill(logoTextGradient);
		lastNamePrompt.setTextOrigin(VPos.TOP);
		mainArea.getChildren().add(lastNamePrompt);	
		
		TextField lastNameTF = new TextField();
		lastNameTF.setMaxWidth(250);
		mainArea.getChildren().add(lastNameTF);
		
		Text emailPrompt = new Text ("Email:");
		emailPrompt.setFont(Font.font("Menlo",FontWeight.BOLD,18));
		emailPrompt.setFill(logoTextGradient);
		emailPrompt.setTextOrigin(VPos.TOP);
		mainArea.getChildren().add(emailPrompt);	
		
		TextField emailTF = new TextField();
		emailTF.setMaxWidth(250);
		mainArea.getChildren().add(emailTF);
		
		Text securityPrompt = new Text ("Mother's Maiden Name:");
		securityPrompt.setFont(Font.font("Menlo",FontWeight.BOLD,18));
		securityPrompt.setFill(logoTextGradient);
		securityPrompt.setTextOrigin(VPos.TOP);
		mainArea.getChildren().add(securityPrompt);	
		
		TextField securityTF = new TextField("Doe");
		securityTF.setMaxWidth(250);
		securityTF.setDisable(true);
		mainArea.getChildren().add(securityTF);
		
		CheckBox newUserPresntCB = new CheckBox("New user present to change security answer?\nDoe is default.");
		newUserPresntCB.setSelected(false);
		
		
		mainArea.getChildren().add(newUserPresntCB);
		
		Text positionPrompt = new Text ("Position:");
		positionPrompt.setFont(Font.font("Menlo",FontWeight.BOLD,18));
		positionPrompt.setFill(logoTextGradient);
		positionPrompt.setTextOrigin(VPos.TOP);
		mainArea.getChildren().add(positionPrompt);
		
		ObservableList<String> positionOptions = null;
		positionOptions = PopulatePositionService.poopulatePositionsList(userSecurityLevel, positionOptions);

		ComboBox<String> positionComboBox = new ComboBox<>(positionOptions);
		positionComboBox.setStyle("-fx-background-color: #FFFFFF");
		positionComboBox.setMaxWidth(250);
		mainArea.getChildren().add(positionComboBox);
		
		CheckBox welecomeCheckBox = new CheckBox("Generate welcome email?");
		welecomeCheckBox.setSelected(true);
		
		
		mainArea.getChildren().add(welecomeCheckBox);
		
		
//Create new user Confirmation ---------------------------------------------------------
		Button createNewUserButton = new Button("Create New User");
		createNewUserButton.setOnAction(event -> 
			{
				System.out.println(enteredUsername + " is attempting to create a new user.");
				Alert confirmationAlert = new Alert(Alert.AlertType.CONFIRMATION);
				confirmationAlert.setTitle("Confirmation");
				confirmationAlert.setHeaderText("Do you wish to continue?");
				confirmationAlert.setContentText("Please ensure all information is accurate before proceeding.");
				Optional<ButtonType> result =
				        confirmationAlert.showAndWait();

				if (result.isPresent()&& result.get() == ButtonType.OK) 
				{

				    System.out.println(enteredUsername + " has confirmed they wish to create a new user.");
				    String newFirstName = new String (firstNameTF.getText().trim().toUpperCase());
				    String newLastName = new String (lastNameTF.getText().trim().toUpperCase());
				    String newEmail = new String (emailTF.getText().trim().toUpperCase());
				    String newMaiden = new String (securityTF.getText().trim().toUpperCase());
				    String newSecurityLevel = positionComboBox.getValue();
				    
				    if(newFirstName.isBlank()|| newLastName.isBlank() ||newEmail.isBlank() || newMaiden.isBlank()|| newSecurityLevel == null || newSecurityLevel.isBlank())
				    {
                        Alert blankEntryAlert = new Alert(Alert.AlertType.ERROR);
                        blankEntryAlert.setTitle("Blank Field Warning");
                        blankEntryAlert.setHeaderText("All fields must be filled.");
        				blankEntryAlert.showAndWait();
        				System.out.println(enteredUsername + " tried to submit new user creation with empty fields.");
        				return;
				    }
				    String newUsername = new String (newFirstName.charAt(0) + newLastName);
				    System.out.println("\n\n ----------STAGED NEW USER VALUES----------\n\n"
				    		+ "Staged First Name: " + newFirstName + "\nStaged Last Name: " + newLastName
				    		+ "\nStaged User Name: " + newUsername +"\nStaged Email: " + newEmail 
				    		+"\nStaged Security Question Answer: " + newMaiden + "\nStaged pre converted security level: "
							+ newSecurityLevel + "\n\n ----------END STAGED USER VALUES--------\n\n");
				    
				    try 
				    {
				    	boolean sendEmail = welecomeCheckBox.isSelected();
						CreateNewUserService.createNewUserAuthenticator(newFirstName, newLastName, newUsername, newEmail, newMaiden, newSecurityLevel, sendEmail);
						UserOptionsHub.showUserOptionsWindow(enteredUsername, userSecurityLevel, mainArea, navBar, root, scene);
						
					} 
				    catch (SQLException e) {
						System.out.println("Error calling CreateNewUserService");
						Alert classCallError = new Alert(Alert.AlertType.ERROR);
						classCallError.setTitle("Error calling method to create new user class. ");
						classCallError.setHeaderText("Please contact IT assistasnce at LukiSoft.");
						classCallError.showAndWait();
						e.printStackTrace();
						return;
					}
				    

				} 
				else
				{

					System.out.println(enteredUsername + " cancelled the create new user operation.");
				}
			});
		
//END Create new user Confirmation ---------------------------------------------------------

		Button goBackButton = new Button("Go Back");
		goBackButton.setOnAction(event ->
		{
			UserOptionsHub.showUserOptionsWindow(enteredUsername, userSecurityLevel, mainArea, navBar, root, scene);
			System.out.println(enteredUsername + " backed out of create new user menu.");
		});
		
		mainArea.getChildren().addAll(createNewUserButton,goBackButton);
		//button styling area
		VBox.setMargin(createNewUserButton, new Insets(25,0,25,0));
		for (javafx.scene.Node node : mainArea.getChildren()) 
		{
			
		    if (node instanceof Button button) 
		    {
		        button.setPrefHeight(50);
		        button.setPrefWidth(300);
		        button.setFont(Font.font("Menlo", FontWeight.BOLD, 16));
		        button.setStyle("-fx-background-color: #ebeced;");
		        button.setMaxWidth(300);
		        button.setMaxHeight(50);
		        button.setOnMouseEntered(event -> {button.setStyle("-fx-background-color: #fafdff");});
		        button.setOnMouseExited(event -> {button.setStyle("-fx-background-color: #ebeced;");});
		        button.setOnMousePressed(event -> {button.setStyle("-fx-background-color: #4f7e9e;");});
		        button.setOnMouseReleased(event ->{button.setStyle("-fx-background-color:  #fafdff;");});
		        button.setCursor(Cursor.HAND);
	    	}
		    
		}
		
		
	}
}

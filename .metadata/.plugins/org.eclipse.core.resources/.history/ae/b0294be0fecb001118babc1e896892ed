package universal;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;

import application.DatabaseConnection;
import javafx.collections.FXCollections;
import javafx.collections.ObservableList;

public class PopulateLists 
{
	
	public static ObservableList<String> selectableDestinationsService() throws SQLException
	{
	    ObservableList<String> selectableDestinations =  FXCollections.observableArrayList();


		    
	        String findDestinationsSql = """
	                SELECT destinationName
	                FROM destinations
	                WHERE destinationName IS NOT NULL
	                ORDER BY destinationName ASC
	                """;

	        
	        try (Connection connection = DatabaseConnection.getConnection(); 
	        		PreparedStatement checkStatement = connection.prepareStatement(findDestinationsSql)) 
	        {


	            
	            try (ResultSet results = checkStatement.executeQuery())
	            {
	                while (results.next())
	                {
	                	selectableDestinations.add(results.getString("destinationName"));
	                }
	            }
	        }

	    return selectableDestinations;
	}
	

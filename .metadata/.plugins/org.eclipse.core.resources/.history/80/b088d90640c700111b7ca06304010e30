package events;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;

import application.DatabaseConnection;
import javafx.collections.FXCollections;
import javafx.collections.ObservableList;
import javafx.geometry.Insets;
import javafx.scene.Cursor;
import javafx.scene.control.CheckBox;
import javafx.scene.control.CheckMenuItem;
import javafx.scene.control.ComboBox;
import javafx.scene.control.CustomMenuItem;
import javafx.scene.control.ListView;
import javafx.scene.control.MenuButton;
import javafx.scene.control.MenuItem;
import javafx.scene.control.SelectionMode;
import javafx.scene.layout.GridPane;
import javafx.scene.text.Font;
import javafx.scene.text.FontWeight;
import javafx.scene.text.Text;
import universal.Styling;

public class EMSCallLeadSection {
	
	public static GridPane EMSCallLeadSection() throws SQLException
	{
		GridPane EMSCallLeadSectionGP = new GridPane();
		
        Text emsCallLeadPrompt = new Text("Call Lead:");
        emsCallLeadPrompt.setFill(Styling.logoGradient());
        emsCallLeadPrompt.setFont(Font.font("Menlo",FontWeight.BOLD,18));
        GridPane.setMargin(emsCallLeadPrompt, new Insets(0, 15, 0, 0));
        
		ObservableList<String> selectableUsers = emsUsers();
		ComboBox<String> userComboBox = new ComboBox<>(selectableUsers);
		userComboBox.getSelectionModel().clearSelection();
		userComboBox.setPromptText("Select Call Lead:");
		userComboBox.setMaxWidth(300);
		userComboBox.setCursor(Cursor.HAND);
        GridPane.setMargin(userComboBox, new Insets(0, 0, 0, 10));
        userComboBox.setStyle("-fx-font-family: 'Menlo';" +"-fx-font-weight: bold;" +"-fx-font-size: 14px;");
        
        Text additionalEMSPrompt = new Text("Additional Members:");
        additionalEMSPrompt.setFill(Styling.logoGradient());
        additionalEMSPrompt.setFont(Font.font("Menlo",FontWeight.BOLD,18));
        GridPane.setMargin(additionalEMSPrompt, new Insets(0, 15, 0, 25));
        
        ObservableList<String> allPersonellAvailable = allPersonell();
        
        MenuButton additionalEMSMenu = new MenuButton("Select Additional Responders:");
        additionalEMSMenu.setStyle("-fx-font-family: 'Menlo';" +"-fx-font-weight: bold;" +"-fx-font-size: 14px;");
        for (String user : allPersonellAvailable)
        {
            CheckBox responderCheckBox = new CheckBox(user);
            CustomMenuItem respondersItem = new CustomMenuItem(responderCheckBox);
            respondersItem.setHideOnClick(false);
            additionalEMSMenu.getItems().add(respondersItem);
        }
		
        
        
        //column -> Row
        EMSCallLeadSectionGP.add(emsCallLeadPrompt, 0, 0);
        EMSCallLeadSectionGP.add(userComboBox, 1, 0);
        EMSCallLeadSectionGP.add(additionalEMSPrompt, 2, 0);
        EMSCallLeadSectionGP.add(additionalEMSMenu, 3, 0);

		
		return EMSCallLeadSectionGP;
		
	}
	
	
	public static ObservableList<String> emsUsers() throws SQLException
	{
	    ObservableList<String> selectableEMSUsers =  FXCollections.observableArrayList();


		    
	        String findUserSql = """
	                SELECT userName
	                FROM users
	                WHERE userSecurityLevel IN (1, 2, 5, 6, 7, 8, 9)
	                ORDER BY SUBSTRING(userName, 2) ASC
	                """;
	        
	        try (Connection connection = DatabaseConnection.getConnection(); 
	        		PreparedStatement checkStatement = connection.prepareStatement(findUserSql)) 
	        {


	            
	            try (ResultSet results = checkStatement.executeQuery())
	            {
	                while (results.next())
	                {
	                	selectableEMSUsers.add(results.getString("userName"));
	                }
	            }
	        }

	    return selectableEMSUsers;

	}
	
	public static ObservableList<String> allPersonell() throws SQLException
	{
	    ObservableList<String> allPersonellAvailable =  FXCollections.observableArrayList();


		    
	        String findUserSql = """
	                SELECT userName
	                FROM users
	                WHERE userSecurityLevel IN (1, 2, 3, 4, 5, 6, 7, 8, 9)
	                ORDER BY SUBSTRING(userName, 2) ASC
	                """;
	        
	        try (Connection connection = DatabaseConnection.getConnection(); 
	        		PreparedStatement checkStatement = connection.prepareStatement(findUserSql)) 
	        {


	            
	            try (ResultSet results = checkStatement.executeQuery())
	            {
	                while (results.next())
	                {
	                	allPersonellAvailable.add(results.getString("userName"));
	                }
	            }
	        }

	    return allPersonellAvailable;

	}
	

}

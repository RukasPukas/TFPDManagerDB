package bulletin;
import java.sql.SQLException;
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.ArrayList;
import java.util.Optional;

import application.LandingPage;
import application.UpdateUserService;
import application.UserOptionsHub;
import javafx.scene.Cursor;
import javafx.scene.Group;
import javafx.scene.Scene;
import javafx.scene.control.TextArea;
import javafx.scene.layout.VBox;
import javafx.scene.paint.Color;
import javafx.scene.paint.CycleMethod;
import javafx.scene.paint.LinearGradient;
import javafx.scene.paint.Stop;
import javafx.scene.text.Font;
import javafx.scene.text.FontWeight;
import javafx.scene.text.Text;
import javafx.scene.control.MenuButton;
import javafx.scene.control.CheckMenuItem;
import javafx.scene.control.MenuItem;
import javafx.application.Platform;
import javafx.collections.ObservableList;
import javafx.geometry.Insets;
import javafx.scene.control.Alert;
import javafx.scene.control.Button;
import javafx.scene.control.ButtonType;
import javafx.scene.control.CheckBox;
import javafx.scene.control.CustomMenuItem;

public class BulletinHub 
{
	
	public static void bulletinHub (String enteredUsername, int userSecurityLevel, VBox mainArea, VBox navBar, Group root, Scene scene) throws SQLException
	{
		mainArea.getChildren().clear();
		UserOptionsHub.setUpUserOptionVBox(mainArea, navBar, root, scene);
		
		LinearGradient logoTextGradient = new LinearGradient(0, 0,0, 1,true,CycleMethod.NO_CYCLE,new Stop(0, Color.web("#39414d")),new Stop(1, Color.web("#4872b5")));

		Text updateBulletinHeader = new Text("Post to Bulletin Board");
		updateBulletinHeader.setFont(Font.font("Menlo",FontWeight.BOLD,24));
		updateBulletinHeader.setFill(logoTextGradient);
		mainArea.getChildren().add(updateBulletinHeader);
		
		
		Text textPrompt = new Text("Text:");
		textPrompt.setFont(Font.font("Menlo",FontWeight.BOLD,16));
		textPrompt.setFill(logoTextGradient);
		mainArea.getChildren().add(textPrompt);
		
		
		TextArea newPostTA = new TextArea();
		newPostTA.setEditable(true);
		newPostTA.prefWidthProperty().bind(mainArea.widthProperty().multiply(0.75));
		newPostTA.maxWidthProperty().bind(mainArea.widthProperty().multiply(0.75));
		newPostTA.setWrapText(true);
		mainArea.getChildren().add(newPostTA);
		

				
		
		Button submitButton = new Button("Submit");
		VBox.setMargin(submitButton, new Insets(25,0,25,0));
		submitButton.setOnAction(event -> 
		{
			System.out.println(enteredUsername +" pressed the submit bulletin post button...");
			String newBulletinText = newPostTA.getText().trim();
			String dateEntered = LocalDate.now().format(DateTimeFormatter.ofPattern("dd/MMMM/yyyy"));
			Boolean emailFlagger;
			
			if(newBulletinText.trim().equals(""))
			{
				Alert blankMessageError = new Alert(Alert.AlertType.ERROR);
				blankMessageError.setTitle("MESSAGE CANNOT BE EMPTY");
				blankMessageError.setHeaderText("Please enter a message.");
				blankMessageError.showAndWait();
				System.out.println("\n**Backed out of submit button due to blank content**");
				return;
			}
		
			ArrayList<String> selectedPositions = new ArrayList<>();
			for (MenuItem item : positionMenu.getItems())
			{
			    if (item instanceof CustomMenuItem customItem)
			    {
			        CheckBox positionCheckBox = (CheckBox) customItem.getContent();

			        if (positionCheckBox.isSelected())
			        {
			            selectedPositions.add(positionCheckBox.getText());
			        }
			    }
			}
			

			System.out.println("\n\nProposed Message:\n" + enteredUsername+ " posted on: " + dateEntered +"\n\n" + newBulletinText+"\n");
			
			Alert confirmationAlert = new Alert(Alert.AlertType.CONFIRMATION);
			confirmationAlert.setTitle("Confirmation");
			confirmationAlert.setHeaderText("Are you sure you want to continue?");
			confirmationAlert.setContentText("Posts are public and cannot be easily undone.");
			Optional<ButtonType> result =
			        confirmationAlert.showAndWait();

			if (result.isPresent()&& result.get() == ButtonType.OK) 
			{
				try 
				{
					PostToBulletinService.updateBulletinDB(enteredUsername, newBulletinText, dateEntered);
				}
			    catch (SQLException e) {
					System.out.println("Error calling PostToBulletinService");
					Alert classCallError = new Alert(Alert.AlertType.ERROR);
					classCallError.setTitle("Error calling method to update bulletin database. ");
					classCallError.setHeaderText("Please contact IT assistance at LukiSoft.");
					classCallError.showAndWait();
					e.printStackTrace();
					return;
				}
				

						
			}
			else
			{
				System.out.println("User backed out bulletin post confirmation.");
			}
			System.out.println("Bulletin DB updated successfully.");
			
			
		});
		
		
		Button goBackButton = new Button("Cancel");
		goBackButton.setOnAction(event ->
			{
				System.out.println(enteredUsername + " backed out of bulletin board posting menu.");
				LandingPage.landingPage(enteredUsername, userSecurityLevel, mainArea, navBar, root, scene);
			});
		
		
		
		mainArea.getChildren().addAll(
		        submitButton,
		        goBackButton
		);
		
		Button[] buttons = {submitButton, goBackButton};
			
		    for (Button button : buttons)
		    {
		        button.setPrefHeight(50);
		        button.setFont(Font.font("Menlo", FontWeight.BOLD, 16));
		        button.setStyle("-fx-background-color: #ebeced;");
		        button.setMaxWidth(300);
		        button.setMaxHeight(50);
		        button.setOnMouseEntered(event -> {button.setStyle("-fx-background-color: #fafdff");});
		        button.setOnMouseExited(event -> {button.setStyle("-fx-background-color: #ebeced;");});
		        button.setOnMousePressed(event -> {button.setStyle("-fx-background-color: #4f7e9e;");});
		        button.setOnMouseReleased(event ->{button.setStyle("-fx-background-color:  #fafdff;");});
		        button.setCursor(Cursor.HAND);

		
		    	}
		
		
		
	}

}

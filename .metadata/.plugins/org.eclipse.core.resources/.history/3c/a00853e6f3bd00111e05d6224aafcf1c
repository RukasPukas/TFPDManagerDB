public class UserEditor 
{
	public static void userEditor(String enteredUsername, int userSecurityLevel, VBox mainArea, VBox navBar, Group root, Scene scene, String userToEdit) throws SQLException
	{
		mainArea.getChildren().clear();
		UserOptionsHub.setUpUserOptionVBox(mainArea, navBar, root, scene);
		
		Text editUserHeader = new Text("Editing: " + userToEdit);
		editUserHeader.setFont(Font.font("Menlo",FontWeight.BOLD,24));
		LinearGradient logoTextGradient = new LinearGradient(0, 0,0, 1,true,CycleMethod.NO_CYCLE,new Stop(0, Color.web("#39414d")),new Stop(1, Color.web("#4872b5")));
		editUserHeader.setFill(logoTextGradient);
		editUserHeader.setTextOrigin(VPos.TOP);
		mainArea.getChildren().add(editUserHeader);
		
		UserAccountInfo userInfo = returnCredentials(userToEdit);
		
		Text firstNamePrompt = new Text("First Name");
		firstNamePrompt.setFont(Font.font("Menlo",FontWeight.BOLD,16));
		firstNamePrompt.setFill(logoTextGradient);
		firstNamePrompt.setTextOrigin(VPos.TOP);
		mainArea.getChildren().add(firstNamePrompt);
		
		TextField firstNameTF = new TextField(userInfo.firstName);
		firstNameTF.setMaxWidth(250);
		mainArea.getChildren().add(firstNameTF);
		
		Text lastNamePrompt = new Text("Last Name");
		lastNamePrompt.setFont(Font.font("Menlo",FontWeight.BOLD,16));
		lastNamePrompt.setFill(logoTextGradient);
		lastNamePrompt.setTextOrigin(VPos.TOP);
		mainArea.getChildren().add(lastNamePrompt);
		
		TextField lastNameTF = new TextField(userInfo.lastName);
		lastNameTF.setMaxWidth(250);
		mainArea.getChildren().add(lastNameTF);
		
		Text emailPrompt = new Text("Email");
		emailPrompt.setFont(Font.font("Menlo",FontWeight.BOLD,16));
		emailPrompt.setFill(logoTextGradient);
		emailPrompt.setTextOrigin(VPos.TOP);
		mainArea.getChildren().add(emailPrompt);
		
		TextField emailTF = new TextField(userInfo.userEmail);
		emailTF.setMaxWidth(250);
		mainArea.getChildren().add(emailTF);
		
		Text securityPrompt = new Text("Security Prompt Answer");
		securityPrompt.setFont(Font.font("Menlo",FontWeight.BOLD,16));
		securityPrompt.setFill(logoTextGradient);
		securityPrompt.setTextOrigin(VPos.TOP);
		mainArea.getChildren().add(securityPrompt);
		
		PasswordField securityTF = new PasswordField();
		securityTF.setText(userInfo.securityAnswer());
		securityTF.setMaxWidth(250);
		mainArea.getChildren().add(securityTF);
		if(!enteredUsername.equals(userToEdit))
		{
			securityTF.setDisable(true);
		}
		
		
		Text securityLevel = new Text("Security Level");
		securityLevel.setFont(Font.font("Menlo",FontWeight.BOLD,16));
		securityLevel.setFill(logoTextGradient);
		securityLevel.setTextOrigin(VPos.TOP);
		mainArea.getChildren().add(securityLevel);
		
		ObservableList<String> positionOptions = null;
		positionOptions = PopulatePositionService.poopulatePositionsList(userSecurityLevel, positionOptions);

		ComboBox<String> positionComboBox = new ComboBox<>(positionOptions);
		positionComboBox.setStyle("-fx-background-color: #FFFFFF");
		//positionComboBox.getSelectionModel().select(());
		positionComboBox.setMaxWidth(250);
		mainArea.getChildren().add(positionComboBox);
		
		ToggleGroup activeGroup = new ToggleGroup();
		RadioButton activeRadio = new RadioButton("Active");
		RadioButton inactiveRadio = new RadioButton("Inactive");
		activeRadio.setToggleGroup(activeGroup);
		inactiveRadio.setToggleGroup(activeGroup);
		
		Text activeLevel = new Text("Set Active Status");
		activeLevel.setFont(Font.font("Menlo",FontWeight.BOLD,16));
		activeLevel.setFill(logoTextGradient);
		activeLevel.setTextOrigin(VPos.TOP);
		mainArea.getChildren().add(activeLevel);

		if(userInfo.activeStatus.equals("active"))
		{
			activeRadio.setSelected(true);
		}
		else
		{
			inactiveRadio.setSelected(true);
		}
		mainArea.getChildren().addAll(activeRadio,inactiveRadio);
		
		
		//BEGIN BUTTONS====================================================================================
		
		
		
		Button updateButton = new Button ("Update User");
		VBox.setMargin(updateButton, new Insets(25,0,25,0));
		updateButton.setOnAction(event ->
		{
			System.out.println("\n" + enteredUsername + " intiated user update...");
			String updatedFName = firstNameTF.getText().toUpperCase();
			String updatedLName = lastNameTF.getText().toUpperCase();
			String updatedUsername = new String (updatedFName.charAt(0) + updatedLName).toUpperCase();
			String updatedEmail = emailTF.getText().toUpperCase();
			String updatedSecurityAnswer = securityTF.getText().toUpperCase();
			String updatedSecurityLevel = positionComboBox.getValue();
			String activityStatus;
			if(activeRadio.isSelected())
			{
				activityStatus = "active";
			}
			else
			{
				activityStatus = "inactive";
			}
			if(updatedSecurityLevel == null)
			{
				updatedSecurityLevel = "No change";
			}
			String securityAnswerReview = "*".repeat(updatedSecurityAnswer.length());
			
			Alert confirmationAlert = new Alert(Alert.AlertType.CONFIRMATION);
			confirmationAlert.setTitle("Confirmation");
			confirmationAlert.setHeaderText("Do you wish to update " + userToEdit + " with the following:?");
			
			confirmationAlert.setContentText("\nNew first name: " + updatedFName + "\nNew last name: " + updatedLName +"\nNew user name: " + updatedUsername
					+"\nNew email: " + updatedEmail + "\nNew security answer: " + securityAnswerReview + "\nNew security level: " + updatedSecurityLevel +
					"\nAccount status: " + activityStatus);
			Optional<ButtonType> result =
			        confirmationAlert.showAndWait();

			if (result.isPresent()&& result.get() == ButtonType.OK) 
			{
				try 
				{
					UpdateUserService.UpdateUserDB(userToEdit, userInfo.userSecurityLevel, updatedFName,updatedLName,updatedUsername,updatedEmail,updatedSecurityAnswer,updatedSecurityLevel);
					
					
					if(enteredUsername.equals(userToEdit))
					{
						Alert successfulUpdateAlert = new Alert(Alert.AlertType.ERROR);
						successfulUpdateAlert.setTitle("Successfully updated account: " + updatedUsername);
						successfulUpdateAlert.setHeaderText("Account Successfully Updated");
						successfulUpdateAlert.setContentText("Your account has been successfully updated,\nA program restart is now required.");
						successfulUpdateAlert.showAndWait();
						Platform.exit();
						
					}
					else
					{
						Alert successfulUpdateAlert = new Alert(Alert.AlertType.ERROR);
						successfulUpdateAlert.setTitle("Successfully updated account: " + updatedUsername);
						successfulUpdateAlert.setHeaderText("Account Successfully Updated");
						successfulUpdateAlert.setContentText("The account changes have been made successfully.");
						successfulUpdateAlert.showAndWait();
						UserOptionsHub.showUserOptionsWindow( enteredUsername, userSecurityLevel,  mainArea,  navBar,  root,  scene);
						
					}
				} 
				catch (SQLException e) 
				{
					Alert populateEditUserListError = new Alert(Alert.AlertType.ERROR);
					populateEditUserListError.setTitle("Error updating user information. ");
					populateEditUserListError.setHeaderText("Please contact IT assistasnce at LukiSoft.");
					populateEditUserListError.showAndWait();
					System.out.println("\n**Failed to update user information..**");
					return;
					
					
				}
			}
			else
			{
				System.out.println("User backed out of user edit confirmation.");
			}

			
		});
		
		mainArea.getChildren().add(updateButton);
		
		
		Button goBackButton = new Button ("Go Back");
		goBackButton.setOnAction(event ->{
			System.out.println(enteredUsername + " went back to edit existing users menu.");
			try {
				EditExistingUser.EditExistingUserGui(enteredUsername, userSecurityLevel, mainArea,  navBar,  root,  scene);
			} catch (SQLException e) {
				Alert populateEditUserListError = new Alert(Alert.AlertType.ERROR);
				populateEditUserListError.setTitle("Error populating user edit list. ");
				populateEditUserListError.setHeaderText("Please contact IT assistasnce at LukiSoft.");
				populateEditUserListError.showAndWait();
				return;
			}
			
		});
		mainArea.getChildren().add(goBackButton);
		
		
		for (javafx.scene.Node node : mainArea.getChildren()) 
		{
			
		    if (node instanceof Button button) {
		        button.setPrefHeight(50);
		        button.setFont(Font.font("Menlo", FontWeight.BOLD, 16));
		        button.setStyle("-fx-background-color: #ebeced;");
		        button.setMaxWidth(300);
		        button.setMaxHeight(50);
		        button.setOnMouseEntered(event -> {button.setStyle("-fx-background-color: #fafdff");});
		        button.setOnMouseExited(event -> {button.setStyle("-fx-background-color: #ebeced;");});
		        button.setOnMousePressed(event -> {button.setStyle("-fx-background-color: #4f7e9e;");});
		        button.setOnMouseReleased(event ->{button.setStyle("-fx-background-color:  #fafdff;");});
		        button.setCursor(Cursor.HAND);

		
		    	}
		}
		
		
		
	}
	
	static UserAccountInfo returnCredentials(String userToEdit) throws SQLException
	{
	    String sql = """
	            SELECT firstName, lastName, userEmail, userSecurityLevel, userSecurityAnswer, status
	            FROM users
	            WHERE userName = ?
	            LIMIT 1
	            """;
	    
	    try (Connection connection = DatabaseConnection.getConnection(); PreparedStatement statement = connection.prepareStatement(sql))
	    {
	    	statement.setString(1, userToEdit);

	    	try (ResultSet results = statement.executeQuery())
	    	{
	    	    if (results.next())
	    	    {
	    	        return new UserAccountInfo(
	    	                results.getString("firstName"),
	    	                results.getString("lastName"),
	    	                results.getString("userEmail"),
	    	                results.getInt("userSecurityLevel"),
	    	                results.getString("userSecurityAnswer"),
	    	                results.getString("status")
	    	        );
	    	    }

	    	    throw new SQLException("Issue locating account.");
	    	}
	    }
		    
	    
	    
	}
	
	public record UserAccountInfo(String firstName,String lastName,String userEmail,int userSecurityLevel, String securityAnswer, String activeStatus){}
}
